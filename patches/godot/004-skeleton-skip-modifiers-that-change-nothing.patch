+bool Skeleton3D::_has_active_modifiers() const {
+	for (const ObjectID &oid : modifiers) {
+		SkeletonModifier3D *mod = ObjectDB::get_instance<SkeletonModifier3D>(oid);
+		if (mod && mod->is_active() && mod->can_modify()) {
+			return true;
+		}
+	}
+	return false;
+}
