+	// The first key after the time, searched with plain comparisons: an approximate
+	// comparison at every step costs more than the search itself.
+	int low = 0;
+	int high = len;
+	while (low < high) {
+		const int mid = (low + high) >> 1;
+		if (keys[mid].time <= p_time) {
+			low = mid + 1;
 		} else {
-			low = middle + 1; //search high end of array
+			high = mid;
 		}
