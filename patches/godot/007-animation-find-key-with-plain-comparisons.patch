+	// A key at about the time is a match. Only the keys on either side can be close enough.
+	int middle = low - 1;
+	if (middle >= 0 && Math::is_equal_approx(p_time, (double)keys[middle].time)) {
+		return middle;
+	}
+	if (low < len && Math::is_equal_approx(p_time, (double)keys[low].time)) {
+		return low;
+	}
